
/* 页面容器 */
.address-page.data-v-ce825346 {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 地址列表 */
.address-list.data-v-ce825346 {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.address-item.data-v-ce825346 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.address-item.data-v-ce825346:last-child {
  border-bottom: none;
}
.address-top.data-v-ce825346 {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.name.data-v-ce825346 {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}
.phone.data-v-ce825346 {
  font-size: 28rpx;
  color: #666;
}
.default-tag.data-v-ce825346 {
  background-color: #07c160;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}
.address-detail.data-v-ce825346 {
  font-size: 26rpx;
  color: #999;
  display: block;
  line-height: 1.5;
}
.address-action.data-v-ce825346 {
  display: flex;
  gap: 10rpx;
}
.edit-btn.data-v-ce825346, .del-btn.data-v-ce825346 {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}
.edit-btn.data-v-ce825346 {
  background-color: #f0f0f0;
  color: #666;
}
.del-btn.data-v-ce825346 {
  background-color: #ff4444;
  color: #fff;
}

/* 空状态 */
.empty-tip.data-v-ce825346 {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 操作按钮区 */
.action-bar.data-v-ce825346 {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.wechat-btn.data-v-ce825346, .add-btn.data-v-ce825346 {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.wechat-btn.data-v-ce825346 {
  background-color: #07c160;
  color: #fff;
}
.add-btn.data-v-ce825346 {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #eee;
}
.icon.data-v-ce825346 {
  font-size: 32rpx;
}
