/* 页面 */
.order-page.data-v-2863420b {
  background: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* tab */
.tab-box.data-v-2863420b {
  display: flex;
  background: #fff;
  margin-bottom: 20rpx;
}
.tab-item.data-v-2863420b {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  position: relative;
}
.tab-item.active.data-v-2863420b {
  color: #07c160;
  font-weight: 500;
}
.tab-item.active.data-v-2863420b::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #07c160;
  border-radius: 3rpx;
}

/* 订单卡片 */
.order-card.data-v-2863420b {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  overflow: hidden;
}

/* 订单头 */
.order-header.data-v-2863420b {
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f2f3f5;
}
.order-no.data-v-2863420b {
  font-size: 26rpx;
  color: #333;
}
.order-status.data-v-2863420b {
  font-size: 26rpx;
  color: #1ea2f1;
  font-weight: 500;
}
.order-status.warning.data-v-2863420b {
  color: #efb240;
}
.order-status.error.data-v-2863420b {
  color: #ff3b30;
}
.order-status.success.data-v-2863420b {
  color: #07c160;
}

/* 商品区域 */
.goods-box.data-v-2863420b {
  padding: 30rpx;
  display: flex;
  align-items: center;
}
.goods-img.data-v-2863420b {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f2f3f5;
  margin-right: 24rpx;
}
.goods-info.data-v-2863420b {
  flex: 1;
}
.goods-title.data-v-2863420b {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.goods-price.data-v-2863420b {
  font-size: 32rpx;
  color: #ff3b30;
  font-weight: bold;
}

/* 按钮区 */
.btn-box.data-v-2863420b {
  padding: 0 30rpx 30rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}
.order-btn.data-v-2863420b {
  margin: 0;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: #f2f3f5;
  color: #666;
  border: none;
}
.order-btn.primary.data-v-2863420b {
  background: #07c160;
  color: #fff;
}
.order-btn.warning.data-v-2863420b {
  background: #efb240;
  color: #fff;
}

/* 空状态 */
.empty-box.data-v-2863420b {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-img.data-v-2863420b {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.4;
  margin-bottom: 20rpx;
}
.empty-text.data-v-2863420b {
  font-size: 28rpx;
  color: #999;
}