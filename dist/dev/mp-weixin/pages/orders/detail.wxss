
.detail-page.data-v-9f5624b7 {
  background: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 120rpx;
}
/* 状态栏 */
.status-bar.data-v-9f5624b7 {
  background: #fff;
  padding: 30rpx;
  text-align: center;
}
.status-text.data-v-9f5624b7 {
  font-size: 32rpx;
  color: #007aff;
  font-weight: bold;
}
/* 商品卡片 */
.goods-card.data-v-9f5624b7 {
  display: flex;
  background: #fff;
  margin: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
}
.goods-img.data-v-9f5624b7 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.goods-info.data-v-9f5624b7 {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.name.data-v-9f5624b7 {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.price.data-v-9f5624b7 {
  font-size: 32rpx;
  color: #ff3333;
  font-weight: bold;
}
/* 信息卡片 */
.info-card.data-v-9f5624b7 {
  background: #fff;
  margin: 0 20rpx 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
}
.info-item.data-v-9f5624b7 {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-item.data-v-9f5624b7:last-child {
  border-bottom: none;
}
.label.data-v-9f5624b7 {
  font-size: 28rpx;
  color: #666;
}
.value.data-v-9f5624b7 {
  font-size: 28rpx;
  color: #333;
  max-width: 60%;
  text-align: right;
}
/* 底部操作栏 */
.bottom-bar.data-v-9f5624b7 {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.btn.data-v-9f5624b7 {
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  border: none;
}
.chat.data-v-9f5624b7 {
  background: #f0f0f0;
  color: #333;
}
.confirm.data-v-9f5624b7 {
  background: #07c160;
  color: #fff;
}
.cancel.data-v-9f5624b7 {
  background: #f0f0f0;
  color: #666;
}
