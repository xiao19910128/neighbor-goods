
/* 页面容器 */
.collect-page.data-v-ea960b16 {
  display: flex;
  flex-direction: column;
  padding: 0 20rpx;
  height: calc(100vh - 90rpx);
  background-color: #f5f5f5;
}

/* 商品列表 */
.goods-list.data-v-ea960b16 {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 商品卡片 */
.goods-card.data-v-ea960b16 {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

/* 商品图片 */
.goods-img.data-v-ea960b16 {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

/* 商品信息 */
.goods-info.data-v-ea960b16 {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 10rpx 0;
}
.title.data-v-ea960b16 {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  /* 标题两行省略 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.price.data-v-ea960b16 {
  font-size: 36rpx;
  color: #ff3b30;
  font-weight: bold;
  margin: 10rpx 0;
}
.address-tip.data-v-ea960b16 {
  font-size: 24rpx;
  color: #999;
}

/* 取消收藏按钮 */
.cancel-btn.data-v-ea960b16 {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background-color: #f0f0f0;
  color: #666;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 6rpx 12rpx;
}

/* 空状态 */
.empty-state.data-v-ea960b16 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 220rpx 0;
  color: #999;
}
.empty-text.data-v-ea960b16 {
  font-size: 28rpx;
  margin-bottom: 30rpx;
}
.to-index-btn.data-v-ea960b16 {
  width: 100%;
  background-color: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
}
