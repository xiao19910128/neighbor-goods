
.message-page.data-v-b77a8c2f {
  background: #f7f8fa;
  min-height: 100vh;
}
.session-list.data-v-b77a8c2f {
  padding: 20rpx;
}
.session-item.data-v-b77a8c2f {
  display: flex;
  gap: 20rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.avatar.data-v-b77a8c2f {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  /* margin-right: 20rpx; */
}
.session-info.data-v-b77a8c2f {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.top.data-v-b77a8c2f {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.nickname.data-v-b77a8c2f {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}
.time.data-v-b77a8c2f {
  font-size: 24rpx;
  color: #999;
}
.bottom.data-v-b77a8c2f {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.last-msg.data-v-b77a8c2f {
  font-size: 26rpx;
  color: #666;
  max-width: 80%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.unread.data-v-b77a8c2f {
  background: #ff3333;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 30rpx;
  text-align: center;
}

/* 空状态 */
.empty-tip.data-v-b77a8c2f {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100vh;
  justify-content: center;
}

