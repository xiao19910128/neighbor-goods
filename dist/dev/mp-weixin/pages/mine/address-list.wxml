<view class="address-page data-v-ce825346"><view wx:if="{{a}}" class="address-list data-v-ce825346"><view wx:for="{{b}}" wx:for-item="item" wx:key="j" class="address-item data-v-ce825346"><view class="address-info data-v-ce825346"><view class="address-top data-v-ce825346"><text class="name data-v-ce825346">{{item.a}}</text><text class="phone data-v-ce825346">{{item.b}}</text><text wx:if="{{item.c}}" class="default-tag data-v-ce825346">默认</text></view><text class="address-detail data-v-ce825346">{{item.d}}{{item.e}}{{item.f}}{{item.g}}</text></view><view class="address-action data-v-ce825346"><button class="edit-btn data-v-ce825346" bindtap="{{item.h}}">编辑</button><button class="del-btn data-v-ce825346" bindtap="{{item.i}}">删除</button></view></view></view><view wx:else class="empty-tip data-v-ce825346"><text class="data-v-ce825346">暂无地址，可通过微信快速添加</text></view><view class="action-bar data-v-ce825346"><button class="wechat-btn data-v-ce825346" bindtap="{{c}}"><text class="icon data-v-ce825346">📍</text> 微信获取地址 </button><button class="add-btn data-v-ce825346" bindtap="{{d}}"><text class="icon data-v-ce825346">+</text> 新增地址 </button></view></view>